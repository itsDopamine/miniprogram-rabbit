    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.18.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
