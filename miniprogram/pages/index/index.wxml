<navigation-bar title="小兔鲜儿" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <swiper class="banner" indicator-dots circular autoplay interval="3000" indicator-color="rgba(255, 255, 255, 0.4)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner__img" src="{{item.imgUrl}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="sections">
    <text class="sections__hint">分类宫格、楼层、猜你喜欢待 Step 3 接入</text>
  </view>
</view>