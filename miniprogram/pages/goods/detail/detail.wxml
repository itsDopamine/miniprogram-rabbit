<navigation-bar title="商品详情" background="#FFFFFF" />

<scroll-view class="body" scroll-y>
  <view class="state" wx:if="{{loading}}">
    <text class="state__text">加载中…</text>
  </view>

  <view class="state" wx:elif="{{error}}">
    <text class="state__text">{{error}}</text>
    <view class="state__btn" wx:if="{{id}}" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <!-- swiper 的高度不会被子元素撑开，正方形靠 rpx 固定 -->
    <swiper
      class="gallery"
      indicator-dots
      indicator-color="rgba(255, 255, 255, 0.5)"
      indicator-active-color="#cf4444"
    >
      <swiper-item wx:for="{{mainPictures}}" wx:key="*this">
        <image
          class="gallery__img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onPreviewMain"
        />
      </swiper-item>
    </swiper>

    <view class="info">
      <view class="info__price">
        <text class="info__symbol">¥</text>
        <text class="info__now">{{price}}</text>
        <!-- 实测有商品 oldPrice 与 price 相同，同价时不摆划线价 -->
        <text class="info__old" wx:if="{{oldPrice && oldPrice !== price}}">¥{{oldPrice}}</text>
      </view>
      <text class="info__name">{{name}}</text>
      <text class="info__desc" wx:if="{{desc}}">{{desc}}</text>
    </view>

    <view class="props" wx:if="{{properties.length}}">
      <view class="props__item" wx:for="{{properties}}" wx:key="name">
        <text class="props__name">{{item.name}}</text>
        <text class="props__value">{{item.value}}</text>
      </view>
    </view>

    <view class="detail" wx:if="{{detailPictures.length}}">
      <view class="detail__title">商品详情</view>
      <!-- widthFix：长图高度由宽度推算，不写死比例 -->
      <image
        class="detail__img"
        wx:for="{{detailPictures}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        data-index="{{index}}"
        bindtap="onPreviewDetail"
      />
    </view>
  </block>
</scroll-view>

<!-- 操作栏在滚动容器外，跟着页面固定，不随内容滚走 -->
<view class="bar" wx:if="{{!loading && !error}}">
  <view class="bar__entry" bindtap="onTapService">
    <text class="bar__entry-text">客服</text>
  </view>
  <view class="bar__entry" bindtap="onTapCart">
    <text class="bar__entry-text">购物车</text>
  </view>
  <view class="bar__actions">
    <view class="bar__btn bar__btn--cart" bindtap="onOpenSku">加入购物车</view>
    <view class="bar__btn bar__btn--buy" bindtap="onOpenSku">立即购买</view>
  </view>
</view>

<!-- 遮罩与面板都 fixed 定位，不参与 page 的 flex 分配 -->
<view
  class="mask {{skuVisible ? 'mask--show' : ''}}"
  bindtap="onCloseSku"
  catchtouchmove="noop"
></view>

<view class="sku {{skuVisible ? 'sku--show' : ''}}">
  <view class="sku__head">
    <image class="sku__pic" src="{{skuPicture}}" mode="aspectFill" />
    <view class="sku__meta">
      <view class="sku__price">
        <text class="sku__symbol">¥</text>
        <text class="sku__num">{{skuPrice}}</text>
      </view>
      <text class="sku__tip">{{selectedText || '请选择规格'}}</text>
    </view>
    <view class="sku__close" bindtap="onCloseSku">
      <view class="sku__close-icon"></view>
    </view>
  </view>

  <!-- scroll-view 必须有高度上限才能滚，内容少时由内容撑开 -->
  <scroll-view class="sku__body" scroll-y>
    <view
      class="sku__group"
      wx:for="{{specs}}"
      wx:key="name"
      wx:for-item="spec"
      wx:for-index="specIndex"
    >
      <text class="sku__group-name">{{spec.name}}</text>
      <view class="sku__values">
        <view
          class="sku__value {{selected[specIndex] === value.name ? 'sku__value--active' : ''}}"
          wx:for="{{spec.values}}"
          wx:for-item="value"
          wx:key="name"
          data-spec-index="{{specIndex}}"
          data-value-name="{{value.name}}"
          bindtap="onTapSpec"
        >
          {{value.name}}
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="sku__footer">
    <view class="sku__confirm" bindtap="onConfirmSku">确定</view>
  </view>
</view>
