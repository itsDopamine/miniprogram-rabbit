<!--pages/home/index.wxml-->
<view class="page">
  <view class="hero">
    <view class="hero__title">小兔鲜</view>
    <view class="hero__desc">S0 · 工程基线与接口冒烟</view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载轮播图…</view>

  <view wx:elif="{{error}}" class="state state--error">
    <view>{{error}}</view>
    <button class="retry" size="mini" bindtap="retry">重试</button>
  </view>

  <swiper
    wx:else
    class="banner"
    indicator-dots
    autoplay
    circular
    interval="3000"
    indicator-color="rgba(255,255,255,0.6)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner__img" src="{{item.imgUrl}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="actions">
    <button class="action action--primary" bindtap="goCategory">去分类页（switchTab）</button>
    <button class="action" bindtap="goLogin">去登录占位页（navigateTo）</button>
  </view>

  <view class="tips">
    <view class="tips__title">S0 自检</view>
    <view>1. 轮播图数据来自 GET /home/banner</view>
    <view>2. Network 面板能看到 source-client: miniapp</view>
    <view>3. 断网时应出现错误态，点「重试」可恢复</view>
    <view>4. 下拉页面可重新拉取数据</view>
  </view>
</view>
