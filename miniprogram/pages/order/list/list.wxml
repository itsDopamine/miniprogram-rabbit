<navigation-bar title="我的订单" background="#FFFFFF" />

<scroll-view class="tabs" scroll-x enable-flex>
  <view
    class="tab {{tabIndex === index ? 'tab--on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="value"
    data-index="{{index}}"
    bindtap="onTapTab"
  >{{item.label}}</view>
</scroll-view>

<view class="state" wx:if="{{loading}}">
  <text class="state__text">加载中…</text>
</view>

<view class="state" wx:elif="{{error}}">
  <text class="state__text">{{error}}</text>
  <view class="state__btn" bindtap="onRetry">重新加载</view>
</view>

<view class="state" wx:elif="{{!list.length}}">
  <text class="state__text">还没有相关订单</text>
</view>

<block wx:else>
  <view class="order" wx:for="{{list}}" wx:key="id" bindtap="onTapOrder" data-id="{{item.id}}">
    <view class="order__head">
      <text class="order__no">{{item.createTime}}</text>
      <text class="order__state">{{item.stateText}}</text>
    </view>

    <view class="order__goods">
      <view class="goods" wx:for="{{item.skus}}" wx:for-item="sku" wx:key="id">
        <image class="goods__img" src="{{sku.image}}" mode="aspectFill" />
        <view class="goods__info">
          <text class="goods__name">{{sku.name}}</text>
          <text class="goods__attrs">{{sku.attrsText}}</text>
          <view class="goods__foot">
            <text class="goods__price">¥{{sku.curPrice}}</text>
            <text class="goods__count">×{{sku.quantity}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="order__foot">
      <text class="order__total">共 {{item.totalNum}} 件，实付 ¥{{item.payMoneyText}}</text>
    </view>

    <!-- 按钮按状态显示：服务端只允许待付款取消、待收货确认收货 -->
    <view class="order__actions" catchtap="noop">
      <block wx:if="{{item.orderState === 1}}">
        <view class="btn" bindtap="onCancel" data-id="{{item.id}}">取消订单</view>
        <view class="btn btn--primary" bindtap="onPay" data-id="{{item.id}}">去支付</view>
      </block>
      <block wx:elif="{{item.orderState === 3}}">
        <view class="btn" bindtap="onLogistics" data-id="{{item.id}}" data-state="{{item.orderState}}">查看物流</view>
        <view class="btn btn--primary" bindtap="onConfirmReceipt" data-id="{{item.id}}">确认收货</view>
      </block>
      <block wx:elif="{{item.orderState === 4 || item.orderState === 5 || item.orderState === 6}}">
        <!-- 已取消(6) 没有物流，不给入口 -->
        <view
          class="btn"
          wx:if="{{item.orderState <= 5}}"
          bindtap="onLogistics"
          data-id="{{item.id}}"
          data-state="{{item.orderState}}"
        >查看物流</view>
        <view class="btn" bindtap="onBuyAgain" data-id="{{item.id}}">再次购买</view>
        <view class="btn" bindtap="onDelete" data-id="{{item.id}}">删除订单</view>
      </block>
    </view>
  </view>

  <view class="more">
    <text class="more__text">{{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多了')}}</text>
  </view>
</block>
