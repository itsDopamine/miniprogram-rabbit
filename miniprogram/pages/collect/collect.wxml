<navigation-bar title="我的收藏" background="#FFFFFF" />

<view class="state" wx:if="{{!list.length}}">
  <text class="state__text">还没有收藏商品</text>
  <view class="state__btn" bindtap="onGoHome">去逛逛</view>
</view>

<view class="list" wx:else>
  <view class="item" wx:for="{{list}}" wx:key="id">
    <image
      class="item__pic"
      src="{{item.picture}}"
      mode="aspectFill"
      data-id="{{item.id}}"
      bindtap="onTapGoods"
    />

    <view class="item__info">
      <text class="item__name" data-id="{{item.id}}" bindtap="onTapGoods">{{item.name}}</text>
      <view class="item__foot">
        <text class="item__price">¥{{item.priceText}}</text>
        <view class="item__remove" catchtap="onRemove" data-id="{{item.id}}">取消收藏</view>
      </view>
    </view>
  </view>
</view>
