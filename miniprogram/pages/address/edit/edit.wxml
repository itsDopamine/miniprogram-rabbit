<navigation-bar title="{{id ? '编辑地址' : '新增地址'}}" background="#FFFFFF" />

<scroll-view class="body" scroll-y>
  <view class="group">
    <view class="row">
      <text class="row__label">收货人</text>
      <input
        class="row__input"
        value="{{form.receiver}}"
        placeholder="姓名"
        placeholder-class="row__ph"
        data-field="receiver"
        bindinput="onInput"
      />
    </view>

    <view class="row">
      <text class="row__label">手机号</text>
      <input
        class="row__input"
        type="number"
        maxlength="11"
        value="{{form.contact}}"
        placeholder="收货人手机号"
        placeholder-class="row__ph"
        data-field="contact"
        bindinput="onInput"
      />
    </view>

    <view class="row">
      <text class="row__label">所在地区</text>
      <picker
        class="row__picker"
        mode="multiSelector"
        range="{{columns}}"
        value="{{indexes}}"
        bindcolumnchange="onRegionColumnChange"
        bindchange="onRegionChange"
      >
        <view class="row__value {{areaText ? '' : 'row__value--empty'}}">
          {{areaText || '请选择省 / 市 / 区'}}
        </view>
      </picker>
    </view>

    <view class="row row--textarea">
      <text class="row__label">详细地址</text>
      <textarea
        class="row__textarea"
        value="{{form.address}}"
        placeholder="街道、门牌号等"
        placeholder-class="row__ph"
        maxlength="80"
        auto-height
        data-field="address"
        bindinput="onInput"
      />
    </view>

    <view class="row">
      <text class="row__label">设为默认</text>
      <view class="row__switch">
        <switch checked="{{form.isDefault}}" color="#cf4444" bindchange="onDefaultChange" />
      </view>
    </view>
  </view>
</scroll-view>

<view class="save {{saving ? 'save--disabled' : ''}}" bindtap="onSave">
  {{saving ? '保存中…' : '保存'}}
</view>
